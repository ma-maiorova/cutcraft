{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CutCraft review 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_id",
          "decision",
          "issue",
          "evidence",
          "requested_change"
        ],
        "properties": {
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "accept",
              "revise_caption",
              "replace_segment",
              "adjust_bounds",
              "needs_human_review"
            ]
          },
          "issue": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "requested_change": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "not": {
                    "const": "accept"
                  }
                }
              }
            },
            "then": {
              "properties": {
                "issue": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "requested_change": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
