{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CutCraft catalog 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_duration",
    "assets_are_real",
    "segments"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "assets_are_real": {
      "type": "boolean"
    },
    "segments": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "start",
          "end",
          "transcript",
          "frame_paths"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "transcript": {
            "type": "string",
            "minLength": 1
          },
          "frame_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
