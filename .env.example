# OpenRouter, только бесплатные модели. Скопировать в локальный .env и заполнить ключ;
# model_client.py загружает .env автоматически, переменные окружения имеют приоритет.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Точные ID :free. Модель монтажёра проверена; модель проверяющего должна принимать изображения.
TEXT_MODEL_NAME=dots-studio/dots-3-note-preview:free
# Кандидаты: python3 scripts/list_free_vision_models.py. dots-3-note-preview проверена, но как критик нестабильна
# (иногда тратит весь лимит на рассуждения) и совпадает с моделью монтажёра; при доступности лучше без длинных рассуждений.
VISION_MODEL_NAME=dots-studio/dots-3-note-preview:free
# Клиент отклоняет любые ID без :free и модели с ненулевой ценой.
OPENROUTER_FREE_ONLY=true
# Общий лимит на один HTTP-запрос (1–120 с). Критик с картинками отвечал за 70–105 с, поэтому 120.
MODEL_TIMEOUT_SECONDS=120
