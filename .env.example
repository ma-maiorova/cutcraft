# OpenRouter: выбран бесплатный API-режим. Адаптер ещё не подключён.
# Скопировать в локальный .env; автоматическая загрузка пока не реализована.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Точные доступные ID :free выбрать и проверить; VISION_MODEL_NAME принимает image input.
TEXT_MODEL_NAME=dots-studio/dots-3-note-preview:free
VISION_MODEL_NAME=
# Требование к будущему клиенту, проверку ещё нужно реализовать.
OPENROUTER_FREE_ONLY=true
MODEL_TIMEOUT_SECONDS=60
