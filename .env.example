# OpenRouter, только бесплатные модели. Скопировать в локальный .env и заполнить ключ;
# model_client.py загружает .env автоматически, переменные окружения имеют приоритет.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Точные ID :free. Модель монтажёра проверена; модель проверяющего должна принимать изображения.
TEXT_MODEL_NAME=dots-studio/dots-3-note-preview:free
VISION_MODEL_NAME=
# Клиент отклоняет любые ID без :free и модели с ненулевой ценой.
OPENROUTER_FREE_ONLY=true
MODEL_TIMEOUT_SECONDS=60
